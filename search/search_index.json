ags/","title":"\u0422\u0435\u0433\u0438","text":""},{"location":"tags/#_1","title":"\u0422\u0435\u0433\u0438","text":""},{"location":"tags/#tag:manuals","title":"manuals","text":"<ul> <li>            \u041e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0435          </li> <li>            \u041e\u0442\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0432 Telegram          </li> </ul>"},{"location":"tags/#tag:\u043f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e","title":"\u043f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e","text":"<ul> <li>            \u041e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0435          </li> <li>            \u041e\u0442\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0432 Telegram          </li> </ul>"},{"location":"about/","title":"\u041e\u0431\u043e \u043c\u043d\u0435","text":""},{"location":"api/","title":"Index","text":""},{"location":"api/redoc/","title":"Redoc","text":""},{"location":"api/swagger/","title":"Swagger","text":""},{"location":"diagrams/","title":"\u0413\u043b\u0430\u0432\u043d\u0430\u044f","text":""},{"location":"diagrams/#_1","title":"\u0414\u0438\u0430\u0433\u0440\u0430\u043c\u043c\u044b","text":""},{"location":"diagrams/#_2","title":"\u041f\u0440\u043e\u0446\u0435\u0441\u0441 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438","text":"<p>UML-\u0434\u0438\u0430\u0433\u0440\u0430\u043c\u043c\u0430 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438: \u043e\u0442 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f